{{ 'trend-products.css' | asset_url | stylesheet_tag }}

<trend-products class="trend-products" id="section-{{ section.id }}">
  <div class="trend-products__container">
    {%- if section.settings.heading != blank
      or section.settings.text != blank
      or section.settings.button_label != blank
    -%}
      <div class="trend-products__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="trend-products__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="trend-products__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a
            href="{{ section.settings.button_link }}"
            class="trend-products__button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="trend-products__list">
        {%- for block in section.blocks -%}
          <div class="trend-products__item" {{ block.shopify_attributes }}>
            <div class="trend-products__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: block.settings.image.alt
                }}
              {%- else -%}
                <div class="trend-products__image-placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              {%- for i in (1..3) -%}
                <div class="trend-products__hotspot-wrapper">
                  {%- if i == 1 -%}
                    {%- assign current_product = block.settings.product_1 -%}
                    {%- assign spot_x = block.settings.spot_1_x -%}
                    {%- assign spot_y = block.settings.spot_1_y -%}
                  {%- elsif i == 2 -%}
                    {%- assign current_product = block.settings.product_2 -%}
                    {%- assign spot_x = block.settings.spot_2_x -%}
                    {%- assign spot_y = block.settings.spot_2_y -%}
                  {%- elsif i == 3 -%}
                    {%- assign current_product = block.settings.product_3 -%}
                    {%- assign spot_x = block.settings.spot_3_x -%}
                    {%- assign spot_y = block.settings.spot_3_y -%}
                  {%- endif -%}

                  {%- if current_product != blank -%}
                    {%- assign first_available_variant = null -%}
                    {%- for variant in current_product.variants -%}
                      {%- if variant.available and first_available_variant == null -%}
                        {%- assign first_available_variant = variant -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- assign is_available = false -%}
                    {%- if first_available_variant != null -%}
                      {%- assign is_available = true -%}
                    {%- endif -%}

                    <button
                      class="trend-products__hotspot"
                      style="left: {{ spot_x }}%; top: {{ spot_y }}%;"
                      aria-label="{{ 'sections.trend_products.open_product' | t: product: current_product.title | default: 'View product' }}"
                      aria-expanded="false"
                    >
                      <span class="trend-products__hotspot-icon" aria-hidden="true">
                        {{ 'icon-plus.svg' | inline_asset_content }}
                      </span>
                    </button>

                    <div
                      class="trend-products__popup"
                      style="left: {{ spot_x }}%; top: {{ spot_y }}%;"
                      role="dialog"
                      aria-label="{{ current_product.title | escape }}"
                    >
                      <div class="trend-products__popup-inner">
                        <div class="trend-products__popup-product">
                          {%- if current_product.featured_image != blank -%}
                            <a
                              href="{{ current_product.url }}"
                              class="trend-products__popup-image-link"
                              tabindex="0"
                              aria-label="{{ current_product.title | escape }}"
                            >
                              {{
                                current_product.featured_image
                                | image_url: width: 120
                                | image_tag: loading: 'lazy', alt: current_product.featured_image.alt
                              }}
                            </a>
                          {%- else -%}
                            <div class="trend-products__popup-placeholder">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 525.5 525.5"
                                aria-hidden="true"
                                focusable="false"
                              >
                                <path d="M324.5 212.7H203c-1.6 0-2.8 1.3-2.8 2.8V308c0 1.6 1.3 2.8 2.8 2.8h121.5c1.6 0 2.8-1.3 2.8-2.8v-92.5c0-1.5-1.3-2.8-2.8-2.8zm1.1 95.3c0 .6-.5 1.1-1.1 1.1H203c-.6 0-1.1-.5-1.1-1.1v-92.5c0-.6.5-1.1 1.1-1.1h121.5c.6 0 1.1.5 1.1 1.1V308z"/>
                                <path d="M210.4 299.5H240v.1s.1 0 .2-.1h75.2v-76.2h-105v76.2zm1.8-7.2l20-20c1-1 2.5-1 3.5 0l22.8 22.8 31.7-33.6c1-1.1 2.6-1.1 3.6-.1l.1.1 22.8 24.3v6.5h-104.5v.0zm101.4-61.7V282l-21.4-22.8-31.6 33.5-23-23c-1.4-1.4-3.8-1.3-5.2.1l-19.1 19.1v-52.9h100.3z"/>
                                <circle cx="232.8" cy="257.4" r="10.7"/>
                              </svg>
                            </div>
                          {%- endif -%}

                          <div class="trend-products__popup-info">
                            <a
                              href="{{ current_product.url }}"
                              class="trend-products__popup-title"
                              tabindex="0"
                            >
                              {{- current_product.title | escape -}}
                            </a>
                            <span class="trend-products__popup-price">
                              {{- current_product.price | money -}}
                            </span>
                            {%- if is_available -%}
                              <button
                                class="trend-products__popup-btn"
                                data-variant-id="{{ first_available_variant.id }}"
                                aria-label="{{ 'sections.trend_products.add_to_cart' | t | default: 'Add to cart' }}: {{ current_product.title | escape }}"
                              >
                                {{ 'sections.trend_products.add_to_cart' | t | default: 'Add to cart' }}
                              </button>
                            {%- else -%}
                              <button
                                class="trend-products__popup-btn"
                                disabled
                                aria-label="{{ 'sections.trend_products.sold_out' | t | default: 'Sold out' }}: {{ current_product.title | escape }}"
                              >
                                {{ 'sections.trend_products.sold_out' | t | default: 'Sold out' }}
                              </button>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</trend-products>

<script src="{{ 'trend-products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Trend products",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live inspired"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are on a mission to inspire and empower with positive messages.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "trend_item",
      "name": "Trend item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Product 1"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "spot_1_x",
          "label": "Spot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "spot_1_y",
          "label": "Spot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "header",
          "content": "Product 2"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "spot_2_x",
          "label": "Spot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 60
        },
        {
          "type": "range",
          "id": "spot_2_y",
          "label": "Spot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 35
        },
        {
          "type": "header",
          "content": "Product 3"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "spot_3_x",
          "label": "Spot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "spot_3_y",
          "label": "Spot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 75
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trend products",
      "blocks": [{ "type": "trend_item" }, { "type": "trend_item" }, { "type": "trend_item" }, { "type": "trend_item" }]
    }
  ]
}
{% endschema %}
