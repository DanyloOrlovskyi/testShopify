{{ 'section-best-sellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-best-sellers.js' | asset_url }}" defer="defer"></script>

<best-sellers id="BestSellers-{{ section.id }}" class="best-sellers" data-section-id="{{ section.id }}">
  <div class="best-sellers__inner">
    <div class="best-sellers__left">
      {%- if section.settings.section_label != blank -%}
        <p class="best-sellers__label">{{ section.settings.section_label | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="best-sellers__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul
          class="best-sellers__collections"
          role="tablist"
          aria-label="{{ section.settings.title | default: 'Best sellers' | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_collection = block.settings.collection
              assign collection_title = block.settings.collection_title

              if collection_title == blank and block_collection != blank
                assign collection_title = block_collection.title
              endif

              if collection_title == blank
                assign collection_title = 'Collection'
              endif
            -%}

            <li class="best-sellers__collection-item" {{ block.shopify_attributes }}>
              <button
                class="best-sellers__collection-button{% if forloop.first %} is-active{% endif %}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="BestSellersPanel-{{ section.id }}-{{ block.id }}"
                id="BestSellersTab-{{ section.id }}-{{ block.id }}"
                data-best-sellers-tab
                data-target="BestSellersPanel-{{ section.id }}-{{ block.id }}"
              >
                <span>{{ collection_title | escape }}</span>
                {{ 'icon-best-sellers-arrow-right.svg' | inline_asset_content }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="best-sellers__right">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign active_product = block.settings.product

            if active_product == blank and block_collection != blank
              assign active_product = block_collection.products.first
            endif
          -%}

          <div
            class="best-sellers__product{% if forloop.first %} is-active{% endif %}"
            id="BestSellersPanel-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="BestSellersTab-{{ section.id }}-{{ block.id }}"
            {% unless forloop.first %}
              hidden
            {% endunless %}
            data-best-sellers-panel
          >
            {%- if active_product != blank -%}
              {%- liquid
                assign product_image = active_product.featured_image
                assign product_variant = active_product.selected_or_first_available_variant
              -%}

              <div class="best-sellers__media">
                <a
                  class="best-sellers__image-link"
                  href="{{ active_product.url }}"
                  aria-label="{{ active_product.title | escape }}"
                >
                  {%- if product_image != blank -%}
                    <picture class="best-sellers__picture">
                      <source
                        media="(max-width: 749px)"
                        srcset="{{ product_image | image_url: width: 430 }} 1x, {{ product_image | image_url: width: 860 }} 2x"
                      >
                      <source
                        media="(min-width: 750px)"
                        srcset="{{ product_image | image_url: width: 580 }} 1x, {{ product_image | image_url: width: 1160 }} 2x"
                      >
                      <img
                        class="best-sellers__image"
                        src="{{ product_image | image_url: width: 580 }}"
                        srcset="{{ product_image | image_url: width: 580 }} 1x, {{ product_image | image_url: width: 1160 }} 2x"
                        alt="{{ product_image.alt | default: active_product.title | escape }}"
                        width="{{ product_image.width }}"
                        height="{{ product_image.height }}"
                        loading="lazy"
                      >
                    </picture>
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'best-sellers__placeholder' }}
                  {%- endif -%}
                </a>

                {%- if active_product.tags.size > 0 -%}
                  <div class="best-sellers__tags" aria-label="Product tags">
                    {%- for tag in active_product.tags limit: 3 -%}
                      <span class="best-sellers__tag{% if tag == 'Sale' %} best-sellers__tag--sale{% endif %}">
                        {{ tag | escape }}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="best-sellers__actions">
                  <button
                    class="best-sellers__action best-sellers__action--wishlist"
                    type="button"
                    aria-label="Add {{ active_product.title | escape }} to wishlist"
                    data-wishlist-trigger
                    data-product-title="{{ active_product.title | escape }}"
                  >
                    {{ 'icon-best-sellers-heart.svg' | inline_asset_content }}
                  </button>

                  <button
                    class="best-sellers__action best-sellers__action--cart"
                    type="button"
                    aria-label="Add {{ active_product.title | escape }} to cart"
                    data-cart-trigger
                    data-variant-id="{{ product_variant.id }}"
                    {% unless active_product.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ 'icon-best-sellers-eye.svg' | inline_asset_content }}
                  </button>
                </div>

                <div class="best-sellers__info">
                  <a class="best-sellers__product-title" href="{{ active_product.url }}">
                    {{ active_product.title | escape }}
                  </a>

                  <div class="best-sellers__price" aria-label="Product price">
                    <span class="best-sellers__price-current{% if product_variant.compare_at_price > product_variant.price %} best-sellers__price-current--sale{% endif %}">
                      {{ product_variant.price | money }}
                    </span>
                    {%- if product_variant.compare_at_price > product_variant.price -%}
                      <span class="best-sellers__price-compare">{{ product_variant.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <div class="best-sellers__empty-product"></div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="best-sellers__modal" data-wishlist-modal aria-hidden="true">
    <button class="best-sellers__overlay" type="button" aria-label="Close wishlist message" data-modal-close></button>
    <div
      class="best-sellers__modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-live="polite"
      aria-labelledby="BestSellersModalText-{{ section.id }}"
    >
      <button
        class="best-sellers__modal-close"
        type="button"
        aria-label="Close wishlist message"
        data-modal-close
      ></button>
      <p class="best-sellers__modal-text" id="BestSellersModalText-{{ section.id }}" data-wishlist-message></p>
    </div>
  </div>
</best-sellers>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trending Products"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection title"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Best sellers"
    }
  ]
}
{% endschema %}
