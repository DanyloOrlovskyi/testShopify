<banner-scroll-images
  style="
    --banner-scroll-images-desktop-height: {{ section.settings.height }};
    --banner-scroll-images-background: {{ section.settings.section_background }};
    --banner-scroll-images-overlay: {{ section.settings.color_overlay }};
    --banner-scroll-images-textColor: {{ section.settings.text_color }};
  "
>
  <div
    class="banner-scroll-images__inner-wrapper js-banner-scroll-images-inner-wrapper"
    hidden
  >
    <div class="banner-scroll-images__cols js-banner-scroll-images-cols">
      <div class="banner-scroll-images__col js-banner-scroll-col--first">
        {%- for i in (1..2) -%}
          {% for block in section.blocks %}
            {% if block.type == 'banner-scroll-first-col' %}
              <div class="banner-scroll__item" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <picture>
                    <source
                      media="(max-width: 420px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 195 }} 1x,
                        {{ block.settings.image | image_url: width: 390 }} 2x,
                      "
                    >
                    <source
                      media="(max-width: 768px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 357 }} 1x,
                        {{ block.settings.image | image_url: width: 714 }} 2x,
                      "
                    >
                    <img
                      class="banner-scroll__item-image"
                      src="{{ block.settings.image | image_url: width: 340 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 340 }} 1x,
                        {{ block.settings.image | image_url: width: 680 }} 2x,
                      "
                      alt="{{ block.settings.image.alt }}"
                    >
                  </picture>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {%- endfor -%}
      </div>

      <div class="banner-scroll-images__col js-banner-scroll-col--second">
        {%- for i in (1..2) -%}
          {% for block in section.blocks %}
            {% if block.type == 'banner-scroll-second-col' %}
              <div class="banner-scroll__item" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <picture>
                    <source
                      media="(max-width: 420px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 195 }} 1x,
                        {{ block.settings.image | image_url: width: 390 }} 2x,
                      "
                    >
                    <source
                      media="(max-width: 768px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 357 }} 1x,
                        {{ block.settings.image | image_url: width: 714 }} 2x,
                      "
                    >
                    <img
                      class="banner-scroll__item-image"
                      src="{{ block.settings.image | image_url: width: 340 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 340 }} 1x,
                        {{ block.settings.image | image_url: width: 680 }} 2x,
                      "
                      alt="{{ block.settings.image.alt }}"
                    >
                  </picture>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {%- endfor -%}
      </div>

      <div class="banner-scroll-images__col js-banner-scroll-col--third">
        {%- for i in (1..2) -%}
          {% for block in section.blocks %}
            {% if block.type == 'banner-scroll-third-col' %}
              <div class="banner-scroll__item" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <picture>
                    <source
                      media="(max-width: 420px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 195 }} 1x,
                        {{ block.settings.image | image_url: width: 390 }} 2x,
                      "
                    >
                    <source
                      media="(max-width: 768px)"
                      srcset="
                        {{ block.settings.image | image_url: width: 357 }} 1x,
                        {{ block.settings.image | image_url: width: 714 }} 2x,
                      "
                    >
                    <img
                      class="banner-scroll__item-image"
                      src="{{ block.settings.image | image_url: width: 340 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 340 }} 1x,
                        {{ block.settings.image | image_url: width: 680 }} 2x,
                      "
                      alt="{{ block.settings.image.alt }}"
                    >
                  </picture>
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {%- endfor -%}
      </div>
    </div>
    <div class="banner-scroll-images__content">
      <div class="banner-scroll-images__content-inner-wrapper">
        {% if section.settings.label != blank %}
          <p class="banner-scroll-images__content-label">{{ section.settings.label }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="banner-scroll-images__content-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="banner-scroll-images__content-text">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            aria-label="{{ section.settings.button_aria_label }}"
            class="banner-scroll-images__content-button"
          >
            {{- section.settings.button_label -}}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</banner-scroll-images>

{% schema %}
{
  "name": "Banner Scroll Images",
  "class": "banner-scroll-images",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Desktop height",
      "options": [
        {
          "value": "400px",
          "label": "400px"
        },
        {
          "value": "450px",
          "label": "450px"
        },
        {
          "value": "500px",
          "label": "500px"
        },
        {
          "value": "550px",
          "label": "550px"
        },
        {
          "value": "600px",
          "label": "600px"
        },
        {
          "value": "650px",
          "label": "650px"
        },
        {
          "value": "700px",
          "label": "700px"
        },
        {
          "value": "750px",
          "label": "750px"
        },
        {
          "value": "800px",
          "label": "800px"
        }
      ],
      "default": "650px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PATH™ Collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "All Sales Are Final."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Keep your mantra close to your heart as your daily reminder, affirmation, and inspiration with necklaces from MantraBand. Sterling silver and 18K gold dipped.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "button_aria_label",
      "label": "Button aria-label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#161E13"
    },
    {
      "type": "color_background",
      "id": "color_overlay",
      "label": "Overlay color",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0) 49%, rgba(0, 0, 0, 0.4) 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "banner-scroll-first-col",
      "name": "First Column Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "banner-scroll-second-col",
      "name": "Second Column Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "banner-scroll-third-col",
      "name": "Third Column Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Scroll Images",
      "blocks": {
        "banner-scroll-first-col": {
          "type": "banner-scroll-first-col"
        },
        "banner-scroll-second-col": {
          "type": "banner-scroll-second-col"
        },
        "banner-scroll-third-col": {
          "type": "banner-scroll-third-col"
        }
      }
    }
  ]
}
{% endschema %}
