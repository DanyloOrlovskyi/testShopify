{%- liquid
  assign collection = collections[section.settings.collection]
  assign hero_image = section.settings.hero_image | default: collection.image
-%}

{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

{%- if collection != blank -%}
  <featured-collection class="featured-collection" id="featured-collection-{{ section.id }}">
    <div class="featured-collection__inner">
      {%- comment -%} Left: collection banner {%- endcomment -%}
      <a class="featured-collection__banner" href="{{ collection.url }}">
        {%- if hero_image != blank -%}
          {%-
            render 'responsive-image',
            image: hero_image,
            class: 'featured-collection__banner-image',
            sizes: '(min-width: 769px) 400px, 100vw',
            loading: 'eager',
            alt: hero_image.alt | default: collection.title,
            widths: '400,600,800,1000'
          -%}
        {%- else -%}
          <div class="featured-collection__banner-placeholder">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
        <div class="featured-collection__banner-overlay"></div>
        <div class="featured-collection__banner-content">
          <p class="featured-collection__banner-title">{{ collection.title }}</p>
          <p class="featured-collection__banner-count">{{ collection.products_count }} products</p>
        </div>
      </a>

      {%- comment -%} Right: product slider {%- endcomment -%}
      <div class="featured-collection__slider-wrapper">
        <button
          class="featured-collection__nav featured-collection__nav--prev"
          type="button"
          aria-label="Previous slide"
        >
          {{ 'arrow-left.svg' | inline_asset_content }}
        </button>

        <button
          class="featured-collection__nav featured-collection__nav--next"
          type="button"
          aria-label="Next slide"
        >
          {{ 'arrow-right.svg' | inline_asset_content }}
        </button>

        <div class="swiper featured-collection__swiper">
          <div class="swiper-wrapper">
            {%- for product in collection.products limit: 16 -%}
              <div class="swiper-slide">
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="featured-collection__pagination"></div>
      </div>
    </div>
  </featured-collection>
{%- endif -%}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script src="{{ 'featured-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "t:sections.featured_collection.settings.hero_image.label",
      "info": "t:sections.featured_collection.settings.hero_image.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.default.name"
    }
  ]
}
{% endschema %}
