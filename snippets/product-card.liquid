{%- assign available_variant = product.selected_or_first_available_variant -%}

<div class="product-card js-product-card">
  <a
    class="product-card__image-link"
    href="{{ product.url }}"
    aria-label="{{ product.title }}"
    style="--ratio-percent: 100%;"
  >
    {%- comment -%}
      Render one <img> per unique variant image for JS show/hide via data-image-id..
      Falls back to product.featured_image or placeholder if no images.
    {%- endcomment -%}
    {%- assign rendered_image_ids = '' -%}
    {%- assign first_image_rendered = false -%}
    {%- for variant in product.variants -%}
      {%- assign variant_img = variant.featured_image | default: product.featured_image -%}
      {%- if variant_img != blank -%}
        {%- assign variant_img_id = variant_img.id | append: '' -%}
        {%- unless rendered_image_ids contains variant_img -%}
          {%- assign rendered_image_ids = rendered_image_ids | append: variant_img_id | append: ',' -%}
          {%- if first_image_rendered -%}
            {%- assign img_class = 'product-card__picture js-product-card-picture' -%}
          {%- else -%}
            {%- assign img_class = 'product-card__picture product-card__picture--active js-product-card-picture' -%}
          {%- endif -%}
          <picture class="{{ img_class }}" data-image-id="{{ variant_img_id }}">
            <source
              media="(max-width: 768px)"
              srcset="
                {{ variant_img | image_url: width: 163 }} 1x,
                {{ variant_img | image_url: width: 326 }} 2x
              "
            >
            <img
              class="product-card__picture__image"
              src="{{ variant_img | image_url: width: 208 }}"
              srcset="
                {{ variant_img | image_url: width: 208 }} 1x,
                {{ variant_img | image_url: width: 416 }} 2x
              "
              alt="{{ variant_img.alt }}"
              loading="lazy"
            >
          </picture>
          {%- assign first_image_rendered = true -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}

    {%- unless first_image_rendered -%}
      {%- if product.image != blank -%}
        <picture>
          <source
            media="(max-width: 768px)"
            srcset="
              {{ product.image | image_url: width: 163 }} 1x,
              {{ product.image | image_url: width: 326 }} 2x
            "
          >
          <img
            class="product-card__picture__image"
            src="{{ product.image | image_url: width: 208 }}"
            srcset="
              {{ product.image | image_url: width: 208 }} 1x,
              {{ product.image | image_url: width: 416 }} 2x
            "
            alt="{{ product.image.alt }}"
            loading="lazy"
          >
        </picture>
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'product-card__placeholder' }}
      {%- endif -%}
    {%- endunless -%}

    <ul class="product-card__tags">
      {%- for tag in product.tags limit: 3 -%}
        {%- assign tag_lower = tag | downcase -%}
        <li
          class="
            product-card__tag
            {% if tag_lower == 'sale' %}product-card__tag--sale{% endif %}
          "
        >
          {{ tag }}
        </li>
      {%- endfor -%}
    </ul>

    {%- if available_variant != blank -%}
      <button
        class="product-card__addToCart js-product-card-addToCart"
        type="button"
        data-variant-id="{{ available_variant.id }}"
        aria-label="Add {{ product.title }} to cart"
      >
        <img
          class="product-card__addToCart-icon"
          src="{{ 'icon-cart.svg' | asset_url }}"
          alt=""
          width="20"
          height="20"
          aria-hidden="true"
        >
      </button>
    {%- endif -%}
  </a>

  <div class="product-card__info">
    {%- comment -%}
      swatch_value priority: swatch.image → swatch.color.rgb → name-to-hex fallback.
      Passed as CSS variable --swatch-bg on the button element.
      Image for JS swap: first variant whose option at this position matches the value name.
    {%- endcomment -%}
    {%- for option in product.options_with_values -%}
      {%- if option.name == 'Color' -%}
        {%- assign color_option_position = option.position | minus: 1 -%}
        <div class="product-card__swatches" role="list" aria-label="Colors">
          {%- for option_value in option.values -%}
            {%- liquid
              assign matching_variant = null
              for variant in product.variants
                if matching_variant == null and variant.options[color_option_position] == option_value.name
                  assign matching_variant = variant
                endif
              endfor
              assign swatch_img = matching_variant.featured_image | default: product.featured_image
              if option_value.swatch.image
                assign swatch_image_url = option_value.swatch.image | image_url: width: 24
                assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
              elsif option_value.swatch.color
                assign swatch_value = option_value.swatch.color
              else
                assign swatch_value = '#BCBBB9'
              endif
            -%}
            <button
              class="product-card__swatch{% if forloop.first %} product-card__swatch--active{% endif %} js-product-card-swatch"
              type="button"
              role="listitem"
              data-image-id="{{ swatch_img.id }}"
              data-variant-id="{{ matching_variant.id }}"
              title="{{ option_value.name }}"
              aria-label="{{ option_value.name }}"
              style="--swatch-bg: {{ swatch_value }};"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <a class="product-card__title" href="{{ product.url }}">{{ product.title }}</a>

    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price-sale">{{ product.price | money }}</span>
        <s class="product-card__price-compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span class="product-card__price-regular">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
