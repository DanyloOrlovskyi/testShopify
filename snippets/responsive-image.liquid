{%- comment -%}
  Renders a responsive image with srcset, based on Shopify Dawn approach.

  Accepts:
  - image     {Object}  Shopify image object. Required.
  - class     {String}  CSS class(es) for the <img> tag.
  - sizes     {String}  The `sizes` attribute. Required for correct browser choice.
  - loading   {String}  'lazy' (default) or 'eager'.
  - alt       {String}  Override for alt text. Falls back to image.alt.
  - widths    {String}  Comma-separated list of pixel widths to include in srcset.
                        Default: '165,360,533,720,940,1066'.

  Usage:
  {%- render 'responsive-image',
    image: product.featured_image,
    class: 'product-card__image product-card__image--active',
    sizes: '(min-width: 769px) calc((100vw - 464px) / 3), 50vw'
  -%}
{%- endcomment -%}

{%- liquid
  assign img_loading  = loading | default: 'lazy'
  assign img_alt      = alt | default: image.alt | default: ''
  assign img_widths   = widths | default: '165,360,533,720,940,1066'
  assign img_widths_a = img_widths | split: ','
-%}

<img
  src="{{ image | image_url: width: 533 }}"
  srcset="
    {%- for w in img_widths_a -%}
      {%- assign w_int = w | plus: 0 -%}
      {%- if image.width >= w_int -%}
        {{ image | image_url: width: w_int }} {{ w_int }}w,
      {%- endif -%}
    {%- endfor -%}
    {{ image | image_url }} {{ image.width }}w
  "
  sizes="{{ sizes }}"
  class="{{ class }}"
  width="{{ image.width }}"
  height="{{ image.height }}"
  loading="{{ img_loading }}"
  alt="{{ img_alt | escape }}"
  {%- if data_image_id %}data-image-id="{{ data_image_id }}"{% endif %}
>
