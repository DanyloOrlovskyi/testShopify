{% assign promo_icon = section.settings.promo_icon %}

{%- if section.settings.promo_text != blank -%}
  <div
    class="minicart__promo"
    style="
      --promo_background:{{ section.settings.promo_background }};
      --promo_text_color: {{ section.settings.promo_text_color }};
    "
  >
    {%- if promo_icon != blank -%}
      <img
        class="minicart__promo-icon"
        src="{{ promo_icon | image_url: width: 24 }}"
        srcset="
          {{ promo_icon | image_url: width: 24 }} 1x,
          {{ promo_icon | image_url: width: 48 }} 2x
        "
        width="24"
        height="24"
        alt="{{ promo_icon.alt | default: 'Promo icon' }}"
        loading="lazy"
      >
    {%- endif -%}
    {{ section.settings.promo_text }}
  </div>
{%- endif -%}
