{%- if section.settings.promo_text != blank -%}
  <div
    class="minicart__promo"
    style="background: {{ section.settings.promo_background }}; color: {{ section.settings.promo_text_color }};"
  >
    {%- if section.settings.promo_icon != blank -%}
      <picture class="minicart__promo-icon--picture">
        <source
          srcset="
            {{ section.settings.promo_icon | image_url: width: 24 }} 1x,
            {{ section.settings.promo_icon | image_url: width: 48 }} 2x
          "
        >
        <img
          class="minicart__promo-icon--image"
          src="{{ section.settings.promo_icon | image_url: width: 24 }}"
          width="{{ section.settings.promo_icon.width }}"
          height="{{ section.settings.promo_icon.height }}"
          alt="{{ section.settings.promo_icon.alt | default: 'Promo' | escape }}"
          loading="lazy"
        >
      </picture>
    {%- endif -%}
    {{ section.settings.promo_text }}
  </div>
{%- endif -%}
