<div class="minicart__product js-minicart-product" data-variant-id="{{ product.variant_id }}">
  <button
    type="button"
    class="minicart__product-remove js-minicart-product-remove"
    aria-label="Remove {{ product.title }}"
  >
    {{ 'icon-trash.svg' | inline_asset_content }}
  </button>

  <a href="{{ product.url }}" class="minicart__product-media">
    {%- if product.image -%}
      <img
        class="minicart__product-media-image"
        src="{{ product.image | image_url: width: 100, height: 100 }}"
        srcset="
          {{ product.image | image_url: width: 100, height: 100 }} 1x,
          {{ product.image | image_url: width: 200, height: 200 }} 2x
        "
        alt="{{ product.title }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>

  <div class="minicart__product-info">
    <a href="{{ product.url }}" class="minicart__product-title">{{ product.title }}</a>

    {%- if product.options_with_values.size > 1 -%}
      <div class="minicart__product-selected-options">
        {%- for option in product.options_with_values -%}
          <p class="minicart__product-selected-option">
            {{ option.name }}:
            <span class="minicart__product-selected-option-value">{{ option.value }}</span>
          </p>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="minicart__product-footer">
      <div class="minicart__product-qty">
        <button
          type="button"
          class="minicart__product-qty-button js-minicart-product-qty-minus"
          aria-label="Decrease quantity"
        >
          {{ 'icon-minus.svg' | inline_asset_content }}
        </button>
        <input
          type="number"
          name="quantity"
          min="0"
          max="{{ product.variant.inventory_quantity }}"
          class="minicart__product-qty-input js-minicart-product-qty-input"
          value="{{ product.quantity }}"
          aria-label="Quantity"
        >
        <button
          type="button"
          class="minicart__product-qty-button js-minicart-product-qty-plus"
          aria-label="Increase quantity"
        >
          {{ 'icon-plus.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="minicart__product-price">
        <span>{{ product.price | money }}</span>
      </div>
    </div>
    <p class="minicart__product-error js-minicart-product-error"></p>
  </div>
</div>
