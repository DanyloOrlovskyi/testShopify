{% liquid
  assign desktop_aspect_ratio = block.settings.video.height | times: 100.0 | divided_by: block.settings.video.width | round: 0
  assign mobile_aspect_ratio = block.settings.video_mobile.height | times: 100.0 | divided_by: block.settings.video_mobile.width | round: 0
%}

<div
  class="slideshow-swiper__slide js-slideshow-swiper-slide"
  style="
    --heading-color: {{ block.settings.heading_color }};
    --description-color: {{ block.settings.description_color }};
    --button-text-color: {{ block.settings.button_text_color }};
    --button-background-color: {{ block.settings.button_background_color }};
    --text-alignment: {{ block.settings.text_alignment }};
    --text-alignment-mobile: {{ block.settings.text_alignment_mobile }};
    --overlay-background:{{ block.settings.overlay_color }};
  "
>
  <div class="slideshow-swiper__slide-overlay"></div>
  <video
    class="slideshow-swiper__slider-html-video"
    data-aspect-ratio="{{ desktop_aspect_ratio }}"
    data-aspect-ratio-mobile="{{ mobile_aspect_ratio }}"
    class="js-media-element"
    loading="lazy"
    loop
    muted
    playsinline
  >
    {%- if block.settings.video_mobile != blank -%}
      <source
        src="{{ block.settings.video_mobile.sources | map: 'url' | first }}"
        media="(max-width: 749px)"
        type="video/mp4"
      >
    {%- endif -%}
    {%- if block.settings.video != blank -%}
      <source
        src="{{ block.settings.video.sources | map: 'url' | first }}"
        media="(min-width: 750px)"
        type="video/mp4"
      >
    {%- endif -%}
    Your browser does not support the video tag.
  </video>

  <div class="slideshow-swiper__slide-content">
    {% if block.settings.heading != blank %}
      <h2 class="slideshow-swiper__slide-content-heading">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <p class="slideshow-swiper__slide-content-description">{{ block.settings.description }}</p>
    {% endif %}

    <div class="slideshow-swiper__slide-content-button-wrapper">
      {% if block.settings.button_label != blank %}
        <a class="slideshow-swiper__slide-content-button" href="{{ block.settings.button_link }}">
          {{- block.settings.button_label -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Slideshow HTML video",
  "class": "swiper-slide",
  "settings": [
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video mobile"
    },
    {
      "type": "header",
      "content": "Background overlay settings"
    },
    {
      "type": "color_background",
      "id": "overlay_color",
      "label": "Color",
      "default": "rgba(0, 0, 0, 0.3)"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color_background",
      "id": "button_background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text alignment settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "HTML video",
      "settings": {
        "video": "",
        "overlay_color": "rgba(0, 0, 0, 0.3)",
        "heading": "Satisfy your top obsession with the range of new arrivals",
        "heading_color": "#fff",
        "description": "Satisfy your top obsession with the range of new arrivals",
        "description_color": "#fff",
        "button_label": "Shop Now",
        "button_link": "#",
        "button_text_color": "#000000",
        "button_background_color": "#ffffff",
        "text_alignment": "left",
        "text_alignment_mobile": "left"
      }
    }
  ]
}
{% endschema %}
