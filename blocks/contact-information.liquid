<div class="contact-info">
  {% if block.settings.icon != blank %}
    <div class="contact-info__icon-wrapper">
      <img
        src="{{ block.settings.icon | image_url: width: 24, height: 24 }}"
        width="24"
        height="24"
        alt="Icon"
        loading="lazy">
    </div>
  {% endif %}
  <div class="contact-info__block-content">
    {% if block.settings.heading != blank %}
      <p class="contact-info__heading">{{ block.settings.heading }}</p>
    {% endif %}
    {% if block.settings.content != blank %}
      <div class="contact-info__content">{{ block.settings.content }}</div>
    {% endif %}
  </div>
</div>
{% schema %}
  {
    "name": "Contact information",
    "class": "store-location__contact-info-block",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Address:"
      }, {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>2205 Rosewood Lane 2205 Rosewood Lane</p>"
      }, {
        "type": "image_picker",
        "id": "icon",
        "label": "Icon"
      }
    ],
    "presets": [
      {
        "name": "Contact information"
      }
    ]
  }
{% endschema %}